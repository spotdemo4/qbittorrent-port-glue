{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "json-ls": {
      "command": ["vscode-json-languageserver", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"]
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    },
    "nixd": {
      "command": ["nixd"]
    }
  }
}
